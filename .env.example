# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO

# API
API_PORT=8000
API_CORS_ORIGINS='["http://localhost:3000"]'

# Supabase Auth token verification
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_LEEWAY_SECONDS=0

# Public M3 RAG reference implementation. Deterministic adapters are for local/CI only.
RAG_WORKER_DATABASE_PASSWORD=replace-with-a-local-rag-worker-password
RAG_WORKER_DATABASE_URL=postgresql+psycopg://rag_worker_login:replace-with-a-local-rag-worker-password@127.0.0.1:54322/postgres
RAG_EMBEDDING_PROFILE_KEY=deterministic-local-v1
RAG_GENERATION_PROVIDER=deterministic
RAG_EXACT_VECTOR_SEARCH=true
RAG_MINIMUM_VECTOR_SIMILARITY=0.35
RAG_CANDIDATE_LIMIT=20
RAG_EVIDENCE_LIMIT=8
RAG_MAXIMUM_CHUNKS_PER_SOURCE=3
RAG_WORKER_LEASE_SECONDS=900
RAG_WORKER_MAXIMUM_ATTEMPTS=3
RAG_WORKER_RETRY_DELAY_SECONDS=30
RAG_WORKER_POLL_SECONDS=2
# Set these only when opting into the OpenAI adapters. Never expose this key to the browser.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_GENERATION_MODEL=gpt-5-mini

# Web server origin
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000

# Web browser configuration (these values are browser-visible and must never contain secrets)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# FastAPI runtime database login. Provision this password after applying local migrations.
API_DATABASE_PASSWORD=replace-with-a-local-api-database-password
DATABASE_URL=postgresql+psycopg://api_login:replace-with-a-local-api-database-password@127.0.0.1:54322/postgres

# Private local document storage and bounded synchronous extraction
KNOWLEDGE_LOCAL_STORAGE_PATH=.data/knowledge
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_MAX_PDF_PAGES=100
KNOWLEDGE_PROCESSING_STALE_SECONDS=900

# Container-to-host equivalents for the local Supabase stack
API_DATABASE_URL_DOCKER=postgresql+psycopg://api_login:replace-with-a-local-api-database-password@host.docker.internal:54322/postgres
SUPABASE_JWKS_URL_DOCKER=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
