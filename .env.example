# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO

# API
API_PORT=8000
API_CORS_ORIGINS='["http://localhost:3000"]'

# Web (this value is browser-visible and must never contain a secret)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local PostgreSQL / pgvector
POSTGRES_DB=ai_support
POSTGRES_USER=ai_support
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://ai_support:replace-with-a-local-password@localhost:5432/ai_support
